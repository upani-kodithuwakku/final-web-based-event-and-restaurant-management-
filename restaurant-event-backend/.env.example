DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=restaurant_event_db
DB_USERNAME=restaurant_app
DB_PASSWORD=CHANGE_THIS
JWT_SECRET=replace-with-a-long-random-local-secret-at-least-64-chars-long

MYSQL_ROOT_PASSWORD=CHANGE_TO_A_DIFFERENT_ROOT_PASSWORD

# Set true locally to create the demo logins listed in the README.
SEED_DEMO_USERS=false


# Add the celebration catalogue on startup (existing packages are preserved).
SEED_EVENT_CATALOG=true
